// Config do niri. Espelha 1:1 a do umbriel (~/.config/umbriel/config.toml) e a
// do mango (~/.config/mango/config.conf) — mesmos autostarts, regras de janela
// e atalhos; só muda a sintaxe e o que cada compositor suporta.
//
// NOTA: niri não tem blur, sombra nem scratchpad. O player de música, que no
// umbriel/mango vive num scratchpad, aqui abre flutuante e o Mod+Shift+M usa o
// focus-or-launch (foca se estiver aberto, abre se não).

// xwayland-satellite é iniciado pelo próprio niri sob demanda (>= 25.08)

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    SDL_VIDEODRIVER "wayland"
}

input {
    keyboard {
        xkb {
            layout "us"
            variant "intl"
        }
        repeat-rate 25
        repeat-delay 400
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.35
    }
}

// TV no HDMI: desligada até o Mod+Alt+H ligar
output "HDMI-A-1" {
    off
}

layout {
    gaps 4

    default-column-width { proportion 0.6; }

    focus-ring {
        off
    }

    border {
        width 1
    }
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"

spawn-at-startup "fcitx5"
spawn-at-startup "noctalia"
spawn-at-startup "hushmic" "--tray"
spawn-sh-at-startup "ghostty -e tmux new-session -A -s main"
spawn-at-startup "brave-origin" "--app-id=cinhimbnkkaeohfgghhklpknlkffjgod" // youtube music
spawn-at-startup "brave-origin" "--app-id=bihdiinlknbhociakahmdjfokjkobgmp" // sable
spawn-at-startup "brave-origin" "--app-id=hnpfjngllnobngcgfapefoaidbinmjnm" // whatsapp
spawn-at-startup "steam"

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width { fixed 1020; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"^brave-.*-Default$"# title="^(WhatsApp|Sable).*$"
    open-on-workspace "4"
}

window-rule {
    match app-id=r#"^brave-cinhimbnkkaeohfgghhklpknlkffjgod-Default$"#
    open-floating true
    open-focused false
    default-column-width { fixed 1225; }
    default-window-height { fixed 936; }
    default-floating-position x=0 y=40 relative-to="top"
}

window-rule {
    match app-id=r#"^steam$"#
    open-on-workspace "5"
}

binds {
    Mod+Return repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Escape repeat=false { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+S repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma repeat=false { spawn "noctalia" "msg" "settings-toggle"; }

    Mod+Shift+T hotkey-overlay-title="Terminal (tmux)" { spawn-sh "ghostty -e tmux new-session -A -s main"; }
    Mod+Shift+Alt+T hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+Shift+F hotkey-overlay-title="Arquivos" { spawn "nautilus"; }
    Mod+Shift+B hotkey-overlay-title="Browser" { spawn "brave-origin"; }
    Mod+Shift+Alt+B hotkey-overlay-title="Browser (privado)" { spawn "brave-origin" "--private"; }
    Mod+Shift+S hotkey-overlay-title="Steam" { spawn "steam"; }
    Mod+Shift+M hotkey-overlay-title="Música" { spawn-sh "focus-or-launch '^brave-cinhimbnkkaeohfgghhklpknlkffjgod-Default$' brave-origin --app-id=cinhimbnkkaeohfgghhklpknlkffjgod"; }
    Mod+Shift+D hotkey-overlay-title="Sable" { spawn-sh "focus-or-launch '^brave-bihdiinlknbhociakahmdjfokjkobgmp-Default$' brave-origin --app-id=bihdiinlknbhociakahmdjfokjkobgmp"; }
    Mod+Shift+G hotkey-overlay-title="WhatsApp" { spawn-sh "focus-or-launch '^brave-hnpfjngllnobngcgfapefoaidbinmjnm-Default$' brave-origin --app-id=hnpfjngllnobngcgfapefoaidbinmjnm"; }

    Mod+Alt+H hotkey-overlay-title="Liga/desliga a TV" { spawn "toggle-tv"; }

    Mod+N { toggle-window-floating; }
    Mod+Shift+W repeat=false { close-window; }
    Mod+BackSpace { maximize-column; }
    Mod+M { maximize-column; }
    Mod+Ctrl+M { fullscreen-window; }
    Mod+O repeat=false { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Left { move-column-left; }
    Mod+Down { move-window-down; }
    Mod+Up { move-window-up; }
    Mod+Right { move-column-right; }

    Mod+Ctrl+H { move-column-to-monitor-left; }
    Mod+Ctrl+J { move-column-to-monitor-down; }
    Mod+Ctrl+K { move-column-to-monitor-up; }
    Mod+Ctrl+L { move-column-to-monitor-right; }

    Mod+P { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+P { spawn "noctalia" "msg" "annotate"; }

    Mod+1 { move-window-to-workspace "1"; }
    Mod+2 { move-window-to-workspace "2"; }
    Mod+3 { move-window-to-workspace "3"; }
    Mod+4 { move-window-to-workspace "4"; }
    Mod+5 { move-window-to-workspace "5"; }
    Mod+6 { move-window-to-workspace "6"; }

    Mod+Q { focus-workspace "1"; }
    Mod+W { focus-workspace "2"; }
    Mod+E { focus-workspace "3"; }
    Mod+R { focus-workspace "4"; }
    Mod+T { focus-workspace "5"; }
    Mod+Y { focus-workspace "6"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
}
