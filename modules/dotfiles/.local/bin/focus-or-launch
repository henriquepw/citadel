#!/usr/bin/env bash
# Foca uma janela pelo app_id, ou abre ela se não tiver nenhuma.
# Usage: focus-or-launch <app_id-regex> <command> [args...]
set -euo pipefail

app_id_pattern=$1
shift

case "${XDG_CURRENT_DESKTOP:-}" in
niri)
	id=$(niri msg --json windows | jq -r --arg pat "$app_id_pattern" \
		'[.[] | select(.app_id != null and (.app_id | test($pat)))][0].id // empty')
	[[ -n "$id" ]] && exec niri msg action focus-window --id "$id"
	;;
mango)
	id=$(mmsg get all-clients | jq -r --arg pat "$app_id_pattern" \
		'[.[] | select(.appid != null and (.appid | test($pat)))][0].id // empty')
	[[ -n "$id" ]] && exec mmsg dispatch focusid client,"$id"
	;;
umbriel)
	id=$(umbriel windows --json | jq -r --arg pat "$app_id_pattern" \
		'[.[] | select(.app_id != null and (.app_id | test($pat)))][0].id // empty')
	[[ -n "$id" ]] && exec umbriel msg "window-focus:$id"
	;;
esac

exec "$@"
