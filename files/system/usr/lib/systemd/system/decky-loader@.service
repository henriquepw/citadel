[Unit]
Description=Decky Loader (plugins do Steam) para o usuário %i
After=network.target
ConditionPathExists=/usr/libexec/decky/PluginLoader

[Service]
Type=simple
User=root
Restart=always
KillMode=process
TimeoutStopSec=15
# o binário vem na imagem; plugins, configurações e logs ficam no homebrew do usuário
ExecStartPre=/usr/bin/install -d -o %i -g %i /home/%i/homebrew
ExecStart=/usr/libexec/decky/PluginLoader
WorkingDirectory=-/home/%i/homebrew
Environment=UNPRIVILEGED_USER=%i
Environment=UNPRIVILEGED_PATH=/home/%i/homebrew
Environment=PRIVILEGED_PATH=/home/%i/homebrew
Environment=LOG_LEVEL=INFO

[Install]
WantedBy=multi-user.target
